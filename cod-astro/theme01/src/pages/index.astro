---
// ── Home page layout ────────────────────────────────────────────────────────
// Sections are rendered in the order defined by the site-builder config
// (siteBuilder.home.sections). Disabled sections are skipped, so merchants can
// reorder / hide parts of the homepage from the dashboard. Each section stays a
// reusable component; streaming components still fetch their own data.
// Fall back to the default order when no config is present.
// ─────────────────────────────────────────────────────────────────────────────
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import Hero from "@/theme/components/home/Hero.astro";
import Slideshow from "@/theme/components/home/Slideshow.astro";
import CategoryCards from "@/theme/components/home/CategoryCards.astro";
import BestSellers from "@/theme/components/home/BestSellers.astro";
import HowItWorks from "@/theme/components/home/HowItWorks.astro";
import NewArrivals from "@/theme/components/home/NewArrivals.astro";
import RichText from "@/theme/components/home/RichText.astro";
import FeaturesBar from "@/theme/components/home/FeaturesBar.astro";
import WhatsAppCTA from "@/theme/components/home/WhatsAppCTA.astro";
import CustomerTestimonials from "@/theme/components/home/CustomerTestimonials.astro";
import { getStoreContext } from "@/theme/config/store";
import type { HomeSectionId } from "../../../../cod-shared/site-builder";

const { config, content, siteBuilder } = await getStoreContext();

// Ordered list of enabled sections (config already merged over defaults).
const sections = siteBuilder.home.sections
  .filter((s) => s.enabled)
  .sort((a, b) => a.order - b.order)
  .map((s) => s.id);

const rows = siteBuilder.home.rowsDesktop;
const rowsMobile = siteBuilder.home.rowsMobile;
const colsDesktop = siteBuilder.home.columnsDesktop;
const colsMobile = siteBuilder.home.columnsMobile;
---

<StoreLayout config={config} content={content} siteBuilder={siteBuilder}>
  {sections.includes("hero") && (
    <Hero content={content} heroConfig={siteBuilder.hero} />
  )}

  {sections.includes("slideshow") && siteBuilder.slideshow.slides.length > 0 && (
    <Slideshow content={content} slides={siteBuilder.slideshow.slides} />
  )}

  {sections.includes("categoryCards") && (
    <CategoryCards content={content} />
  )}

  {sections.includes("bestSellers") && (
    <BestSellers
      currencySymbol={config.currencySymbol}
      content={content}
      rows={rows}
      rowsMobile={rowsMobile}
      columnsDesktop={colsDesktop}
      columnsMobile={colsMobile}
    />
  )}

  {sections.includes("howItWorks") && (
    <HowItWorks content={content} />
  )}

  {sections.includes("newArrivals") && (
    <NewArrivals
      currencySymbol={config.currencySymbol}
      content={content}
      rows={rows}
      rowsMobile={rowsMobile}
      columnsDesktop={colsDesktop}
      columnsMobile={colsMobile}
    />
  )}

  {sections.includes("richText") && (
    <RichText
      title={siteBuilder.richtext.title}
      body={siteBuilder.richtext.body}
      ctaLabel={siteBuilder.richtext.ctaLabel}
      ctaHref={siteBuilder.richtext.ctaHref}
      image={siteBuilder.richtext.image}
      align={siteBuilder.richtext.align}
    />
  )}

  {sections.includes("featuresBar") && (
    <FeaturesBar content={content} />
  )}

  {sections.includes("whatsappCta") && (
    <WhatsAppCTA content={content} />
  )}

  {sections.includes("testimonials") && (
    <CustomerTestimonials config={config} content={content} />
  )}
</StoreLayout>
