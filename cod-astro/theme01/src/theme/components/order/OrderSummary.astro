---
import type { Product, Offer } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";

interface Props {
  product: Product;
  basePrice: number;
  cur: string;
  offers: Offer[];
  content: StoreFrontContent;
  summaryDisplay?: "open" | "closed" | "hidden";
}

const { product, basePrice, cur, offers, content, summaryDisplay = "open" } = Astro.props;

if (summaryDisplay === "hidden") return null;

const isClosed = summaryDisplay === "closed";

function fmt(n: number) {
  return n.toLocaleString("ar-DZ");
}
---

<div class="rounded-xl border border-[var(--clr-border)] p-4 sm:p-6 bg-[var(--clr-surface)]">

  {isClosed && (
  <button type="button" id="summary-toggle" class="w-full flex items-center justify-between gap-2 text-[0.875rem] font-semibold cursor-pointer" style="color: var(--clr-text)">
    <span>{content.totalLabel}</span>
    <svg class="w-4 h-4 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </button>
  )}

  <div id="summary-content" class:list={["space-y-3", isClosed && "hidden"]}>
    <!-- Product line: Better mobile layout -->
    <div class="flex items-start justify-between gap-2 text-[0.8125rem] sm:text-[0.875rem] font-medium" style="color: var(--clr-text)">
      <div class="flex items-start gap-1.5 min-w-0 flex-1">
        <span id="summary-qty-label" class="shrink-0">1 ×</span>
        <span class="line-clamp-2 break-words">{product.name}</span>
      </div>
      <span id="summary-item-price" class="font-semibold shrink-0 whitespace-nowrap" style="color: var(--clr-text)">
        {fmt(basePrice)} {cur}
      </span>
    </div>
    
    <!-- Shipping line -->
    <div class="flex items-center justify-between text-[0.8125rem] sm:text-[0.875rem] font-medium" style="color: var(--clr-text-2)">
      <span>{content.shippingLabel}</span>
      <span id="summary-shipping" class="whitespace-nowrap" style="color: var(--clr-text-2)">{content.shippingCalculated}</span>
    </div>
    
    <!-- Offer rows -->
    {offers.map((offer) => {
      const isFreeShipping = offer.discountType === "free_shipping";
      const rewardLabel    = offer.rewardProductName + (offer.rewardVariantLabel ? ` (${offer.rewardVariantLabel})` : "");
      return (
        <div id={`offer-row-${offer.id}`} class="hidden flex items-center justify-between gap-2 text-[0.8125rem] sm:text-[0.875rem] font-medium" style="color: var(--clr-success)">
          {isFreeShipping ? (
            <>
              <span class="truncate flex-1">{content.shippingLabel}</span>
              <span class="shrink-0 whitespace-nowrap">{content.offerFreeShippingBadge}</span>
            </>
          ) : (
            <>
              <span class="truncate flex-1">{rewardLabel} × {offer.rewardQuantity}</span>
              <span class="shrink-0 whitespace-nowrap">{content.offerFreeLabel}</span>
            </>
          )}
        </div>
      );
    })}
    
    <!-- Total line: Better mobile sizing -->
    <div class="pt-3 sm:pt-4 mt-2 border-t border-[var(--clr-border)] flex items-center justify-between gap-2">
      <span class="font-semibold text-[0.9375rem] sm:text-[1rem]" style="color: var(--clr-text)">{content.totalLabel}</span>
      <span id="summary-total" class="font-bold text-[1.125rem] sm:text-[1.375rem] tracking-tight whitespace-nowrap" style="color: var(--clr-primary)">
        {fmt(basePrice)} {cur}
      </span>
    </div>
  </div>
</div>
