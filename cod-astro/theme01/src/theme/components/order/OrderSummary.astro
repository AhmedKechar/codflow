---
import type { Product, Offer } from "@/core/api/types";

interface Props {
  product: Product;
  basePrice: number;
  cur: string;
  offers: Offer[];
  content: any;
  summaryDisplay?: "open" | "closed" | "hidden";
}

const { product, basePrice, cur, offers, content, summaryDisplay = "open" } = Astro.props;

if (summaryDisplay === "hidden") return null;

const isClosed = summaryDisplay === "closed";

function fmt(n: number) {
  return n.toLocaleString("ar-DZ");
}
---

<div class="rounded-xl border border-[var(--clr-border)] overflow-hidden">
  <button type="button" id="summary-toggle" class="w-full flex items-center justify-between px-4 py-3" data-closed={isClosed ? "1" : "0"}>
    <span class="font-semibold text-base">ملخص الطلبية</span>
    <svg class:list={["w-4 h-4 transition-transform", isClosed && "rotate-180"]} style="color: var(--clr-text-2)" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </button>
  <div id="summary-content" class:list={["px-4 pb-4 space-y-3", isClosed && "hidden"]}>
    <div class="flex items-center justify-between" dir="rtl">
      <div class="flex items-center gap-2">
        <span id="summary-qty-label" class="font-medium">{product.name}</span>
        <span id="summary-qty-badge" class="w-6 h-6 rounded-full bg-[var(--clr-primary)] text-white text-xs flex items-center justify-center font-bold">
          ×1
        </span>
      </div>
      <span id="summary-item-price" class="font-semibold" style="color: var(--clr-text)">
        {fmt(basePrice)} {cur}
      </span>
    </div>

    <div class="flex items-center justify-between text-[0.875rem] font-medium" style="color: var(--clr-text-2)">
      <span>{content.shippingLabel}</span>
      <span id="summary-shipping" class="whitespace-nowrap" style="color: var(--clr-text-2)">{content.shippingCalculated}</span>
    </div>

    {offers.map((offer) => {
      const rewardLabel = offer.rewardProductName + (offer.rewardVariantLabel ? ` (${offer.rewardVariantLabel})` : "");
      return (
        <div id={`offer-row-${offer.id}`} class="hidden flex items-center justify-between gap-2 text-[0.875rem] font-medium" style="color: var(--clr-success)">
          <span class="truncate flex-1">{rewardLabel} x {offer.rewardQuantity}</span>
          <span class="shrink-0 whitespace-nowrap">{content.offerFreeLabel}</span>
        </div>
      );
    })}

    <div class="pt-4 mt-2 border-t border-[var(--clr-border)] flex items-center justify-between gap-2">
      <span class="font-semibold text-[1rem]" style="color: var(--clr-text)">{content.totalLabel}</span>
      <span id="summary-total" class="font-bold text-[1.625rem] tracking-tight whitespace-nowrap" style="color: var(--clr-primary)">
        {fmt(basePrice)} {cur}
      </span>
    </div>
  </div>
</div>
