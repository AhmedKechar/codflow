---
import Select from "@/theme/components/ui/Select.astro";
import { Icon } from "astro-icon/components";
import { WILAYAS } from "@/core/data/wilayas";
import type { OrderFormConfig } from "@/core/api/types";

interface Props {
  content: any;
  fieldErrors: any;
  isRTL: boolean;
  orderFormConfig?: OrderFormConfig | null;
}

const { content, fieldErrors, isRTL, orderFormConfig } = Astro.props;

const cfg = {
  showName:        orderFormConfig?.showName        ?? true,
  showPhone:       orderFormConfig?.showPhone       ?? true,
  showEmail:       orderFormConfig?.showEmail       ?? false,
  showAddress:     orderFormConfig?.showAddress     ?? true,
  showWilaya:      orderFormConfig?.showWilaya      ?? true,
  showCommune:     orderFormConfig?.showCommune     ?? true,
  showDeliveryType: orderFormConfig?.showDeliveryType ?? true,
  showNotes:       orderFormConfig?.showNotes       ?? false,
  showQuantity:    orderFormConfig?.showQuantity     ?? true,
};
---

<div class="space-y-5 pt-2">
  <div class="flex items-center gap-3 py-2">
    <div class="h-px flex-1 bg-[var(--clr-border)]"></div>
    <span class="text-xs font-semibold uppercase tracking-[0.05em]" style="color: var(--clr-text-2)">{content.formDeliverySection}</span>
    <div class="h-px flex-1 bg-[var(--clr-border)]"></div>
  </div>

  {cfg.showName && (
  <div>
    <label for="f-name" class="form-label">
      {content.formNameLabel} <span class="text-[var(--clr-error)]">*</span>
    </label>
    <input
      id="f-name" type="text" name="customerName"
      required autocomplete="name"
      placeholder={content.formNamePlaceholder}
      class:list={["form-input", fieldErrors.customerName && "error"]}
    />
    {fieldErrors.customerName && (
      <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.customerName[0]}</p>
    )}
  </div>
  )}

  {cfg.showPhone && (
  <div>
    <label for="f-phone" class="form-label">
      {content.formPhoneLabel} <span class="text-[var(--clr-error)]">*</span>
    </label>
    <input
      id="f-phone" type="tel" name="phone"
      required autocomplete="tel" inputmode="tel"
      placeholder={content.formPhonePlaceholder}
      dir="ltr"
      class:list={["form-input", fieldErrors.phone && "error"]}
    />
    {fieldErrors.phone && (
      <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.phone[0]}</p>
    )}
  </div>
  )}

  {cfg.showEmail && (
  <div>
    <label for="f-email" class="form-label">{content.formEmailLabel ?? "البريد الإلكتروني"}</label>
    <input
      id="f-email" type="email" name="email"
      autocomplete="email"
      placeholder={content.formEmailPlaceholder ?? "بريدك الإلكتروني"}
      dir="ltr"
      class="form-input"
    />
  </div>
  )}

  {cfg.showWilaya && (
  <div class="mb-1">
    <Select
      id="f-wilaya"
      name="wilayaId"
      label={content.formWilayaLabel}
      placeholder={content.formWilayaPlaceholder}
      searchPlaceholder={content.searchLabel}
      noResultsText={content.noResultsLabel}
      required={true}
      error={fieldErrors.wilayaId?.[0]}
      options={WILAYAS.map(w => ({
        value: w.id,
        label: `${w.id.toString().padStart(2, "0")} — ${isRTL ? w.nameAr : w.name}`
      }))}
    />
    {fieldErrors.wilayaId && (
      <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.wilayaId[0]}</p>
    )}
  </div>
  )}

  {cfg.showCommune && (
  <div class="mb-1">
    <Select
      id="f-commune"
      name="communeId"
      label={content.formCommuneLabel}
      placeholder={content.formCommuneDisabled}
      searchPlaceholder={content.searchLabel}
      noResultsText={content.noResultsLabel}
      required={true}
      error={fieldErrors.communeId?.[0]}
      options={[]}
      dynamic={true}
    />
    {fieldErrors.communeId && (
      <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.communeId[0]}</p>
    )}
  </div>
  )}

  {cfg.showDeliveryType && (
  <div>
    <fieldset>
      <legend class="form-label">{content.formDeliveryLabel}</legend>
      <div class="grid grid-cols-2 gap-3" id="delivery-type-group">
        {[
          { value: "home",      icon: "heroicons:home", label: content.formHomeDelivery },
          { value: "stop_desk", icon: "heroicons:cube", label: content.formStopDesk },
        ].map(({ value, icon, label }, i) => (
          <label class="delivery-radio-label relative cursor-pointer group">
            <input
              type="radio" name="deliveryType" value={value}
              checked={i === 0} class="sr-only delivery-radio-input"
            />
            <div class:list={[
              "h-14 rounded-lg border flex items-center justify-center gap-2.5 font-semibold text-sm transition-colors select-none cursor-pointer",
              i === 0
                ? "border-[var(--clr-primary)] text-[var(--clr-primary)] bg-[var(--clr-primary)]/5"
                : "border-[var(--clr-border)] text-[var(--clr-text-2)] bg-[var(--clr-surface)]"
            ]}>
              <Icon name={icon} class="w-5 h-5" /><span>{label}</span>
            </div>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
  )}

  {cfg.showAddress && (
  <div id="address-field-container">
    <label for="f-address" class="form-label">{content.formAddressLabel}</label>
    <input
      id="f-address" type="text" name="address"
      autocomplete="street-address"
      placeholder={content.formAddressPlaceholder}
      class="form-input"
    />
  </div>
  )}

  {cfg.showNotes && (
  <div>
    <label for="f-notes" class="form-label">{content.formNotesLabel}</label>
    <textarea
      id="f-notes" name="notes" rows="2"
      placeholder={content.formNotesPlaceholder}
      class="form-input"
    ></textarea>
  </div>
  )}
</div>
