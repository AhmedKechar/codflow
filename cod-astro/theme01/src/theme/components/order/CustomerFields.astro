---
import Select from "@/theme/components/ui/Select.astro";
import { Icon } from "astro-icon/components";
import { WILAYAS } from "@/core/data/wilayas";
import type { OrderFormConfig } from "@/core/api/types";

interface Props {
  content: any;
  fieldErrors: any;
  isRTL: boolean;
  orderFormConfig?: OrderFormConfig | null;
}

const { content, fieldErrors, isRTL, orderFormConfig } = Astro.props;

const cfg = {
  showName:        orderFormConfig?.showName        ?? true,
  showPhone:       orderFormConfig?.showPhone       ?? true,
  showEmail:       orderFormConfig?.showEmail       ?? false,
  showAddress:     orderFormConfig?.showAddress     ?? false,
  showWilaya:      orderFormConfig?.showWilaya      ?? true,
  showCommune:     orderFormConfig?.showCommune     ?? true,
  showDeliveryType: orderFormConfig?.showDeliveryType ?? true,
  showNotes:       orderFormConfig?.showNotes       ?? false,
  showQuantity:    orderFormConfig?.showQuantity     ?? true,
};
---

<div class="space-y-2 pt-1">
  <style>
    .custom-select-container > label { display: none !important; }
    .custom-select-container { margin-bottom: 0 !important; }
  </style>

  {cfg.showDeliveryType && (
  <div id="delivery-type-container" class="hidden">
    <fieldset>
      <div class="grid grid-cols-2 gap-3" id="delivery-type-group">
        {[
          { value: "home",      icon: "heroicons:home", label: content.formHomeDelivery },
          { value: "stop_desk", icon: "heroicons:cube", label: content.formStopDesk },
        ].map(({ value, icon, label }, i) => (
          <label class="delivery-radio-label relative cursor-pointer group">
            <input
              type="radio" name="deliveryType" value={value}
              checked={i === 0} class="sr-only delivery-radio-input"
            />
            <div class:list={[
              "h-12 rounded-lg border flex items-center justify-center gap-2.5 font-semibold text-sm transition-colors select-none cursor-pointer",
              i === 0
                ? "border-[var(--clr-primary)] text-[var(--clr-primary)] bg-[var(--clr-primary)]/5"
                : "border-[var(--clr-border)] text-[var(--clr-text-2)] bg-[var(--clr-surface)]"
            ]}>
              <Icon name={icon} class="w-5 h-5" /><span class="delivery-label-text">{label}</span>
            </div>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
  )}

  {(cfg.showName || cfg.showPhone) && (
  <div class="grid grid-cols-2 gap-3">
    {cfg.showName && (
    <div class="relative">
      <span class="absolute inset-y-0 start-0 ps-3 flex items-center pointer-events-none" style="color: var(--clr-text-2)">
        <Icon name="heroicons:user" class="w-4 h-4" />
      </span>
      <input
        id="f-name" type="text" name="customerName"
        required autocomplete="name"
        placeholder={content.formNameLabel}
        class:list={["form-input !ps-10", fieldErrors.customerName && "error"]}
      />
      {fieldErrors.customerName && (
        <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.customerName[0]}</p>
      )}
    </div>
    )}

    {cfg.showPhone && (
    <div class="relative">
      <span class="absolute inset-y-0 start-0 ps-3 flex items-center pointer-events-none" style="color: var(--clr-text-2)">
        <Icon name="heroicons:phone" class="w-4 h-4" />
      </span>
      <input
        id="f-phone" type="tel" name="phone"
        required autocomplete="tel" inputmode="tel"
        placeholder={content.formPhoneLabel}
        dir="rtl"
        class:list={["form-input !ps-10", fieldErrors.phone && "error"]}
      />
      {fieldErrors.phone && (
        <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.phone[0]}</p>
      )}
    </div>
    )}
  </div>
  )}

  {cfg.showEmail && (
  <div>
    <input
      id="f-email" type="email" name="email"
      autocomplete="email"
      placeholder={content.formEmailLabel ?? "البريد الإلكتروني"}
      dir="ltr"
      class="form-input"
    />
  </div>
  )}

  {(cfg.showWilaya || cfg.showCommune) && (
  <div class="grid grid-cols-2 gap-3">
    {cfg.showWilaya && (
    <div>
      <Select
        id="f-wilaya"
        name="wilayaId"
        label=""
        placeholder={content.formWilayaLabel}
        searchPlaceholder={content.searchLabel}
        noResultsText={content.noResultsLabel}
        required={false}
        error={fieldErrors.wilayaId?.[0]}
        icon="heroicons:map-pin"
        options={WILAYAS.map(w => ({
          value: w.id,
          label: `${w.id.toString().padStart(2, "0")} — ${isRTL ? w.nameAr : w.name}`
        }))}
      />
      {fieldErrors.wilayaId && (
        <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.wilayaId[0]}</p>
      )}
    </div>
    )}

    {cfg.showCommune && (
    <div>
      <Select
        id="f-commune"
        name="communeId"
        label=""
        placeholder={content.formCommuneLabel}
        searchPlaceholder={content.searchLabel}
        noResultsText={content.noResultsLabel}
        required={false}
        error={fieldErrors.communeId?.[0]}
        icon="heroicons:building-office"
        options={[]}
        dynamic={true}
      />
      {fieldErrors.communeId && (
        <p class="text-[0.8125rem] font-medium mt-2 ps-1" style="color: var(--clr-error)">{fieldErrors.communeId[0]}</p>
      )}
    </div>
    )}
  </div>
  )}

  {cfg.showAddress && (
  <div id="address-field-container" class="hidden">
    <input
      id="f-address" type="text" name="address"
      autocomplete="street-address"
      placeholder={content.formAddressLabel}
      class="form-input"
    />
  </div>
  )}

  {cfg.showNotes && (
  <div>
    <textarea
      id="f-notes" name="notes" rows="2"
      placeholder={content.formNotesLabel}
      class="form-input"
    ></textarea>
  </div>
  )}
</div>
