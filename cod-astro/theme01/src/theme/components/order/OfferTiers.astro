---
import type { Product, Offer } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import CountdownTimer from "./CountdownTimer.astro";

interface Props {
  product: Product;
  offers: Offer[];
  basePrice: number;
  comparePrice: number | null;
  cur: string;
  isRTL: boolean;
  content: StoreFrontContent;
  defaultVariantId: string | null;
}

const { product, offers, basePrice, comparePrice, cur, isRTL, content, defaultVariantId } = Astro.props;
const hasVariants = product.hasVariants && product.variantOptions && product.variantOptions.length > 0;

function fmt(n: number) {
  return n.toLocaleString("ar-DZ");
}

function varVal(variations: unknown, key: string): string | undefined {
  return (variations as Record<string, string>)[key];
}
---

{offers.length > 0 ? (
  <div class="space-y-2.5" id="offer-tier-section">

    <!-- Section header -->
    <div class="flex items-center gap-3 mb-1">
      <div class="h-px flex-1 bg-[var(--clr-border)]"></div>
      <span class="text-xs font-semibold uppercase tracking-[0.05em]" style="color: var(--clr-text-2)">{content.offerSectionTitle}</span>
      <div class="h-px flex-1 bg-[var(--clr-border)]"></div>
    </div>

    <!-- ── Base tier: Buy 1 ── -->
    <label
      id="tier-card-base"
      class="tier-label relative flex flex-col rounded-xl border cursor-pointer transition-colors duration-150 select-none overflow-hidden"
      style="border-color: var(--clr-primary); background: color-mix(in srgb, var(--clr-primary) 4%, white)"
      data-qty="1"
      data-offer-id=""
    >
      <input type="radio" name="tierSelect" value="base" class="sr-only" checked />

      <!-- Header row -->
      <div class="flex items-center gap-3 px-4 pt-4 pb-3.5">
        <!-- Radio dot -->
        <div class="tier-check w-[1.125rem] h-[1.125rem] rounded-full border-[2px] flex items-center justify-center shrink-0 transition-colors duration-150" style="border-color: var(--clr-primary); background: var(--clr-primary)">
          <Icon name="heroicons:check" class="w-2 h-2 text-white" />
        </div>

        <!-- Title + badge -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-semibold text-[0.9375rem] leading-tight" style="color: var(--clr-text)">{content.offerBuyOne}</span>
            <span class="px-2 py-0.5 rounded-full text-[0.6875rem] font-semibold uppercase tracking-normal leading-none" style="background: var(--clr-surface-alt); color: var(--clr-text-2)">{content.offerFullPrice}</span>
          </div>
        </div>

        <!-- Price -->
        <div class="text-end shrink-0">
          <span class="font-bold text-[1rem] leading-none" style="color: var(--clr-primary)" id="tier-price-base">
            {fmt(basePrice)}&nbsp;<span class="text-[0.625rem] font-semibold">{cur}</span>
          </span>
          {comparePrice != null && (
            <div class="text-[0.625rem] line-through font-medium mt-0.5" style="color: var(--clr-text-2)">{fmt(comparePrice)} {cur}</div>
          )}
        </div>
      </div>

      <!-- Variant pills — visible when base tier is active -->
      {hasVariants && (
        <div id="tier-variants-base" class="px-4 pb-4 pt-2.5 border-t border-[var(--clr-border)] space-y-3">
          {product.variantOptions!.map((opt) => (
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.05em] mb-2" style="color: var(--clr-text-2)">{opt.name}</p>
              <div class="flex gap-1.5 flex-wrap">
                {opt.values.map((val, vi) => (
                  <button
                    type="button"
                    class:list={[
                      "variant-opt shrink-0 flex items-center gap-1.5 h-8 px-3 rounded-md border font-medium text-[0.8125rem] transition-colors duration-150 whitespace-nowrap",
                      vi === 0
                        ? "text-[var(--clr-primary)] bg-[var(--clr-primary)]/5 border-[var(--clr-primary)]"
                        : ""
                    ]}
                    style={vi !== 0 ? "border-color: var(--clr-border); background: var(--clr-surface); color: var(--clr-text-2)" : undefined}
                    data-option={opt.name}
                    data-value={val.value}
                    data-first={vi === 0 ? "1" : ""}
                  >
                    {val.hexColor && (
                      <span class="w-3.5 h-3.5 rounded-full shrink-0 border border-[var(--clr-border)]" style={`background: ${val.hexColor}`}></span>
                    )}
                    <span class="leading-none">{val.value}</span>
                    <span class:list={["check-icon transition-opacity duration-150 shrink-0", vi === 0 ? "opacity-100" : "opacity-0"]} style="color: var(--clr-primary)">
                      <Icon name="heroicons:check" class="w-2.5 h-2.5" />
                    </span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </label>

    <!-- ── Offer tiers ── -->
    {offers.map((offer, i) => {
      const isFreeShipping   = offer.discountType === "free_shipping";
      const savePct          = !isFreeShipping
        ? Math.round(offer.rewardQuantity / (offer.triggerQuantity + offer.rewardQuantity) * 100)
        : 0;
      const savingsAmt       = !isFreeShipping ? offer.rewardQuantity * basePrice : 0;
      const tierPrice        = basePrice * offer.triggerQuantity;
      const tierCompare      = comparePrice != null ? comparePrice * offer.triggerQuantity : null;
      const shownByDefault   = !offer.triggerVariantId || offer.triggerVariantId === defaultVariantId;
      const lockedVariant    = offer.triggerVariantId
        ? product.variants.find(v => v.id === offer.triggerVariantId)
        : null;
      const rewardLabel      = offer.rewardProductName + (offer.rewardVariantLabel ? ` — ${offer.rewardVariantLabel}` : "");

      return (
        <label
          id={`tier-card-${offer.id}`}
          class:list={[
            "tier-label relative flex flex-col rounded-xl border cursor-pointer transition-colors duration-150 select-none overflow-hidden",
            !shownByDefault && "hidden"
          ]}
          style="border-color: var(--clr-border); background: var(--clr-surface)"
          data-qty={offer.triggerQuantity}
          data-offer-id={offer.id}
          data-discount-type={offer.discountType}
          data-tier-card
        >
          <input type="radio" name="tierSelect" value={offer.id} class="sr-only" />

          <!-- Header row -->
          <div class="flex items-start gap-3 px-4 pt-4 pb-3.5">

            <!-- Radio dot -->
            <div class="tier-check w-[1.125rem] h-[1.125rem] rounded-full border-[2px] flex items-center justify-center shrink-0 mt-[3px] transition-colors duration-150" style="border-color: var(--clr-border); background: var(--clr-surface)">
              <Icon name="heroicons:check" class="w-2 h-2 text-transparent" />
            </div>

            <!-- Labels -->
            <div class="flex-1 min-w-0 space-y-1.5">
              <!-- Name + badge row -->
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-[0.9375rem] leading-tight" style="color: var(--clr-text)">{offer.name}</span>
                {i === 0 && (
                  <span class="px-2 py-0.5 rounded-full text-white text-[0.6875rem] font-semibold uppercase tracking-normal leading-none" style="background: var(--clr-primary)">
                    {content.offerMostPopular}
                  </span>
                )}
                {isFreeShipping ? (
                  <span class="px-2 py-0.5 rounded-full text-white text-[0.6875rem] font-semibold uppercase tracking-normal leading-none shrink-0" style="background: var(--clr-success)">
                    {content.offerFreeShippingBadge}
                  </span>
                ) : (
                  <span class="px-2 py-0.5 rounded-full text-white text-[0.6875rem] font-semibold uppercase tracking-normal leading-none shrink-0" style="background: var(--clr-primary)">
                    {content.offerSaveBadge.replace("{n}", String(savePct))}
                  </span>
                )}
              </div>

              <!-- Reward / savings line -->
              {isFreeShipping ? (
                <p class="text-[0.8125rem] font-medium leading-tight flex items-center gap-1.5" style="color: var(--clr-success)">
                  <Icon name="heroicons:truck" class="w-4 h-4 shrink-0" /> {content.offerFreeShippingBadge}
                </p>
              ) : (
                <>
                  <p class="text-[0.8125rem] font-medium leading-tight flex items-center gap-1.5" style="color: var(--clr-success)">
                    <Icon name="heroicons:gift" class="w-4 h-4 shrink-0" /> {rewardLabel} — {content.offerFreeLabel}
                  </p>
                  {savingsAmt > 0 && (
                    <p class="text-[0.6875rem] font-medium leading-none" style="color: var(--clr-text-2)">
                      {content.offerSavingsText.replace("{amount}", fmt(savingsAmt)).replace("{currency}", cur)}
                    </p>
                  )}
                </>
              )}
            </div>

            <!-- Price -->
            <div class="text-end shrink-0 mt-0.5">
              <span class="font-bold text-[1rem] leading-none" style="color: var(--clr-primary)" id={`tier-price-${offer.id}`}>
                {fmt(tierPrice)}&nbsp;<span class="text-[0.625rem] font-semibold">{cur}</span>
              </span>
              {tierCompare != null && (
                <div class="text-[0.625rem] line-through font-medium mt-0.5" style="color: var(--clr-text-2)">{fmt(tierCompare)} {cur}</div>
              )}
            </div>
          </div>

          <div class="px-4 pb-2">
            <CountdownTimer endsAt={offer.endsAt} />
          </div>

          <!-- Per-unit variant pills — shown when this offer is selected -->
          {hasVariants && (
            <div id={`tier-variants-${offer.id}`} class="hidden px-4 pb-4 pt-3 border-t border-[var(--clr-border)]">
              {Array.from({ length: offer.triggerQuantity }, (_, unitIndex) => (
                <div class:list={["space-y-2.5", unitIndex > 0 && "mt-3.5 pt-3.5 border-t border-[var(--clr-border)]"]}>

                  <!-- Unit label -->
                  <div class="flex items-center gap-2">
                    <span class="w-[1.125rem] h-[1.125rem] rounded-full flex items-center justify-center text-[0.5rem] font-bold text-white shrink-0" style="background: var(--clr-primary)">
                      {unitIndex + 1}
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-[0.05em]" style="color: var(--clr-text-2)">
                      {content.offerUnitLabel.replace("{n}", String(unitIndex + 1))}
                    </span>
                  </div>

                  <!-- Option groups -->
                  {product.variantOptions!.map((opt) => {
                    const lockedValue = lockedVariant
                      ? varVal(lockedVariant.variations, opt.name)
                      : null;
                    return (
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.05em] mb-1.5" style="color: var(--clr-text-2)">{opt.name}</p>
                        <div class="flex gap-1.5 flex-wrap">
                          {opt.values.map((val, vi) => {
                            const isActive     = lockedValue ? lockedValue === val.value : vi === 0;
                            const isHidden     = !!lockedValue && lockedValue !== val.value;
                            return !isHidden ? (
                              <button
                                type="button"
                                class:list={[
                                  "tier-unit-opt h-8 px-2.5 rounded-md border font-medium text-[0.75rem] transition-colors duration-150 flex items-center gap-1.5 whitespace-nowrap",
                                  isActive
                                    ? "text-[var(--clr-primary)] bg-[var(--clr-primary)]/5 border-[var(--clr-primary)]"
                                    : "",
                                  !!lockedValue && "pointer-events-none"
                                ]}
                                style={!isActive ? "border-color: var(--clr-border); background: var(--clr-surface); color: var(--clr-text-2)" : undefined}
                                data-tier-id={offer.id}
                                data-unit={unitIndex}
                                data-option={opt.name}
                                data-value={val.value}
                                data-active={isActive ? "1" : "0"}
                              >
                                {val.hexColor && (
                                  <span class="w-3 h-3 rounded-full shrink-0 border border-[var(--clr-border)]" style={`background: ${val.hexColor}`}></span>
                                )}
                                <span class="leading-none">{val.value}</span>
                              </button>
                            ) : null;
                          })}
                        </div>
                      </div>
                    );
                  })}
                </div>
              ))}
            </div>
          )}
        </label>
      );
    })}
  </div>
) : null}
<p id="qty-stock-hint" class="text-[0.75rem] text-amber-600 font-bold text-end hidden mt-1" aria-live="polite"></p>
