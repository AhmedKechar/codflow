---
interface Props {
  endsAt: string | null;
}
const { endsAt } = Astro.props;
---

{endsAt && (
  <div
    id="countdown-timer"
    data-ends-at={endsAt}
    class="flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm"
    style="background: color-mix(in srgb, var(--clr-primary) 10%, transparent); color: var(--clr-primary);"
  >
    <svg class="h-4 w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span id="countdown-label">ينتهي خلال:</span>
    <span id="countdown-value" class="font-bold" dir="ltr">--:--:--</span>
  </div>
)}

<script>
  function initCountdown() {
    const timer = document.getElementById('countdown-timer');
    if (!timer) return;

    const endsAt = timer.dataset.endsAt;
    if (!endsAt) return;

    const endTime = new Date(endsAt).getTime();
    const valueEl = document.getElementById('countdown-value');

    function update() {
      const now = Date.now();
      const diff = endTime - now;

      if (diff <= 0) {
        const tierCard = timer.closest('[data-tier-card]') || timer.closest('[data-offer-id]') || timer.parentElement;
        if (tierCard) tierCard.style.display = 'none';
        return;
      }

      const hours = Math.floor(diff / 3600000);
      const minutes = Math.floor((diff % 3600000) / 60000);
      const seconds = Math.floor((diff % 60000) / 1000);

      valueEl.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }

    update();
    setInterval(update, 1000);
  }

  initCountdown();
</script>
