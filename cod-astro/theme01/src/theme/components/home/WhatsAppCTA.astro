---
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="px-8 py-16 sm:px-16 sm:py-20 card flex flex-col items-center text-center">

      <div class="w-16 h-16 mb-8 rounded-xl bg-surface-alt border border-border flex items-center justify-center text-primary">
        <Icon name="heroicons:chat-bubble-left" class="w-8 h-8" />
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold text-text-main tracking-tight mb-6 text-balance max-w-2xl leading-[1.15]">
        {content.promoTitle}
      </h2>
      <p class="text-text-muted font-normal text-base sm:text-lg mb-10 max-w-lg mx-auto text-pretty">
        {content.promoSub}
      </p>
      <a
        href="/products"
        class="group inline-flex items-center justify-center gap-3 btn-primary !w-auto !px-10 min-h-[3.5rem] text-base"
      >
        {content.promoCtaText}
        <Icon name="heroicons:arrow-right" class="w-5 h-5 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" aria-hidden="true" />
      </a>
    </div>
</section>
