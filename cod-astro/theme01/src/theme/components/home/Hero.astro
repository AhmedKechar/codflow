---
import type { StoreFrontContent } from "@/theme/config/content";
import type { HeroConfig } from "../../../../../../cod-shared/site-builder";
import { Icon } from "astro-icon/components";

interface Props {
  content: StoreFrontContent;
  heroConfig?: HeroConfig;
}

const { content, heroConfig } = Astro.props;

const eyebrow = heroConfig?.eyebrow ?? content.heroEyebrow;
const title = heroConfig?.title ?? content.heroTitle;
const subtitle = heroConfig?.subtitle ?? content.heroSubtitle;
const primaryLabel = heroConfig?.primaryCtaLabel ?? content.heroCtaPrimary;
const primaryHref = heroConfig?.primaryCtaHref ?? "/products";
const secondaryLabel = heroConfig?.secondaryCtaLabel ?? content.heroCtaSecondary;
const secondaryHref = heroConfig?.secondaryCtaHref ?? "#best-sellers";
---

<section class="hero-bg-subtle overflow-hidden relative -mt-[calc(4.5rem+var(--safe-top))] pt-[calc(4.5rem+var(--safe-top))]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-center min-h-[500px] sm:min-h-[520px] lg:min-h-[560px]">

      <div class="flex flex-col justify-center py-16 sm:py-20 lg:py-24 relative z-20 text-center">
        <div class="space-y-6 sm:space-y-8 max-w-2xl mx-auto">
          {/* Eyebrow badge */}
          {eyebrow && (
            <div class="animate-fade-in-up">
              <span class="inline-flex items-center text-[0.75rem] font-medium uppercase tracking-[0.15em] px-4 py-1.5 text-text-muted">
                {eyebrow}
              </span>
            </div>
          )}

          {/* Headline */}
          <h1
            class="text-[2rem] sm:text-[2.75rem] lg:text-[3.75rem] font-semibold leading-[1.1] tracking-tight animate-fade-in-up [animation-delay:100ms] text-balance text-text-main"
          >
            {title}
          </h1>

          {/* Subtitle */}
          <p
            class="text-base sm:text-lg font-normal leading-relaxed animate-fade-in-up [animation-delay:200ms] text-pretty max-w-md mx-auto text-text-muted"
          >
            {subtitle}
          </p>

          {/* CTA buttons */}
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 animate-fade-in-up [animation-delay:300ms]">
            <a
              href={primaryHref}
              class="btn-primary group !w-full sm:!w-auto !px-10 h-14 sm:h-14 text-base"
            >
              {primaryLabel}
              <Icon name="heroicons:arrow-right" class="w-5 h-5 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
            </a>
            <a
              href={secondaryHref}
              class="inline-flex items-center justify-center px-10 h-14 sm:h-14 text-sm font-semibold transition-colors border border-border bg-surface w-full sm:w-auto text-text-main hover:text-primary"
            >
              {secondaryLabel}
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s var(--animate-spring) forwards;
    opacity: 0;
  }
</style>
