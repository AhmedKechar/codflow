---
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;

const steps = [
  { num: "1", title: content.contentHowStep1Title ?? content.howStep1Title, sub: content.contentHowStep1Sub ?? content.howStep1Sub, icon: "heroicons:shopping-bag" },
  { num: "2", title: content.contentHowStep2Title ?? content.howStep2Title, sub: content.contentHowStep2Sub ?? content.howStep2Sub, icon: "heroicons:chat-bubble-left-right" },
  { num: "3", title: content.contentHowStep3Title ?? content.howStep3Title, sub: content.contentHowStep3Sub ?? content.howStep3Sub, icon: "heroicons:banknotes" },
];
---

<section
  id="how-it-works"
  class="py-16 sm:py-24"
  style="background: var(--clr-surface-alt)"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text-main">
        {content.contentHowItWorksTitle ?? content.howItWorksTitle}
      </h2>
      <p class="text-base sm:text-lg font-normal mt-4 leading-relaxed text-text-muted">
        {content.contentHowItWorksSubtitle ?? content.howItWorksSub}
      </p>
    </div>

    <!-- Steps grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
      {steps.map((step) => (
        <div class="flex flex-col items-center text-center group">
          <!-- Icon container -->
          <div
            class="relative w-20 h-20 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 mb-8"
            style={`background: var(--clr-surface); border-radius: var(--radius-card); border: 1px solid var(--clr-border)`}
          >
            <div class="text-primary">
              <Icon name={step.icon} class="w-7 h-7" />
            </div>
            <span
              class="absolute -top-3 -end-3 w-8 h-8 flex items-center justify-center text-sm font-semibold rounded-full text-white"
              style="background: var(--clr-primary)"
            >
              {step.num}
            </span>
          </div>
          <div>
            <h3 class="font-semibold text-lg mb-3 text-text-main">
              {step.title}
            </h3>
            <p class="text-[0.9375rem] font-normal leading-relaxed max-w-[280px] mx-auto text-text-muted">
              {step.sub}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
