---
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;

const features = [
  { icon: "heroicons:check-badge",  title: content.feature1Title },
  { icon: "heroicons:truck",        title: content.feature2Title },
  { icon: "heroicons:banknotes",    title: content.feature3Title },
  { icon: "heroicons:clock",        title: content.feature5Title },
];
---

<section class="border-y border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-border rtl:divide-x-reverse">
      {features.map((f) => (
        <div class="flex flex-col items-center justify-center text-center p-8 gap-4 group">
          <div class="text-text-muted transition-colors group-hover:text-primary">
            <Icon name={f.icon} class="w-6 h-6" />
          </div>
          <span class="text-[0.8125rem] font-semibold uppercase tracking-widest leading-tight text-text-main">
            {f.title}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
