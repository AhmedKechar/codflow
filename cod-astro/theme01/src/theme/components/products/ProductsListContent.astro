---
// ── STREAMING COMPONENT ──
// Fetches products and categories, renders the full products listing
// Allows parent page to stream this after layout renders
import ProductCard from "@/theme/components/product/ProductCard.astro";
import { Icon } from "astro-icon/components";
import { fetchProductsRaw, fetchCategoriesRaw } from "@/core/api/client";
import {
  getDefaultSiteBuilder,
  type ProductsConfig,
} from "../../../../../../cod-shared/site-builder";

interface Props {
  currencySymbol: string;
  content: any;
  productsConfig?: Partial<ProductsConfig>;
}

const { currencySymbol, content, productsConfig } = Astro.props;

// Merge the dashboard config over defaults (backward compatible: absent =
// current layout). Safe because mergeSiteBuilder shapes the object.
const cfg: ProductsConfig = {
  ...getDefaultSiteBuilder().products,
  ...(productsConfig ?? {}),
};

const colDesktop =
  ({ 2: "lg:grid-cols-2", 3: "lg:grid-cols-3", 4: "lg:grid-cols-4", 5: "lg:grid-cols-5", 6: "lg:grid-cols-6" } as Record<number, string>)[cfg.desktopCols] ?? "lg:grid-cols-4";
const colMobile =
  ({ 1: "grid-cols-1", 2: "grid-cols-2", 3: "grid-cols-3" } as Record<number, string>)[cfg.mobileCols] ?? "grid-cols-2";

// Fetch products and categories in parallel (this component streams when ready)
const [products, categories] = await Promise.all([
  fetchProductsRaw(),
  fetchCategoriesRaw(),
]);

const shownProducts = cfg.pageSize > 0 ? products.slice(0, cfg.pageSize) : products;
---

<div class="max-w-6xl mx-auto px-5 py-8">
  <!-- Breadcrumb -->
  <nav aria-label={content.allProductsSection} class="flex items-center gap-1.5 flex-wrap text-sm mb-4" style="color: var(--clr-text-2)">
    <a href="/" data-astro-prefetch="hover" class="hover:underline" style="color: var(--clr-text-2)">{content.breadcrumbHome}</a>
    <span aria-hidden="true" class="text-xs">›</span>
    <span aria-current="page" style="color: var(--clr-text)">{content.allProductsSection}</span>
  </nav>

  <div class="flex items-end justify-between mb-8">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--clr-text)">{content.allProductsSection}</h1>
      <p class="text-[0.8125rem] font-medium mt-1" style="color: var(--clr-text-2)">
        {products.length} {content.productCountLabel}
      </p>
    </div>
  </div>

  <!-- Category filter -->
  {cfg.showCategoryFilter && categories.length > 0 && (
    <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide pb-4 mb-8 touch-pan-x">
      <a
        href="/products"
        data-astro-prefetch="hover"
        class="shrink-0 px-4 py-2 rounded-full text-[0.875rem] font-medium transition-colors bg-primary border border-primary text-white"
      >
        {content.allLabel}
      </a>
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          data-astro-prefetch="hover"
          class="shrink-0 px-4 py-2 rounded-full text-[0.875rem] font-medium transition-colors hover:text-text-main bg-surface border border-border"
          style="color: var(--clr-text-2)"
        >
          {cat.name}
        </a>
      ))}
    </div>
  )}

  {shownProducts.length > 0 ? (
    <div class={`grid ${colMobile} ${colDesktop} gap-4 md:gap-6`}>
      {shownProducts.map((p, i) => (
        <ProductCard
          product={p}
          currencySymbol={currencySymbol}
          eager={i < 4}
          content={content}
        />
      ))}
    </div>
  ) : (
    <div class="py-24 text-center">
      <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 text-primary" style="background: var(--clr-surface-alt)">
        <Icon name="heroicons:shopping-bag" class="w-8 h-8" />
      </div>
      <h2 class="text-xl font-semibold mb-2" style="color: var(--clr-text)">{content.emptyStoreTitle}</h2>
      <p class="font-medium" style="color: var(--clr-text-2)">{content.emptyStoreSub}</p>
    </div>
  )}
</div>
