---
import { Icon } from "astro-icon/components";

interface Props {
  enabled: boolean;
  delaySeconds: number;
  discountPercent: number;
  discountCode: string;
  expiresAt: string;
  productName: string;
  cur: string;
  content: any;
}

const { enabled, delaySeconds, discountPercent, discountCode, expiresAt, productName, cur, content } = Astro.props;

if (!enabled) return null;

function fmt(n: number) {
  return n.toLocaleString("ar-DZ");
}
---

<div id="urgency-popup" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden">
  <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="urgency-popup-card">
    <!-- Header with gradient -->
    <div class="relative px-6 py-8 text-center" style="background: linear-gradient(135deg, var(--clr-primary), var(--clr-accent, #f59e0b))">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4xKSIvPjwvc3ZnPg==')] opacity-50"></div>
      
      <div class="relative z-10">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-white/20 flex items-center justify-center">
          <Icon name="heroicons:fire" class="w-8 h-8 text-white" />
        </div>
        
        <h3 class="text-2xl font-bold text-white mb-2">
          {content.urgencyTitle || "عرض محدود!"}
        </h3>
        
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 rounded-full">
          <span class="text-3xl font-black text-white">{discountPercent}%</span>
          <span class="text-sm font-medium text-white/90">{content.urgencySubtitle || "خصم خاص لك"}</span>
        </div>
      </div>
    </div>
    
    <!-- Content -->
    <div class="px-6 py-6 space-y-4">
      <p class="text-center text-sm" style="color: var(--clr-text-2)">
        {content.urgencyDescription || "استخدم كود الخصم عند الطلب واحصل على خصم حصري"}
      </p>
      
      <!-- Discount code -->
      <div class="relative">
        <input
          type="text"
          readonly
          value={discountCode}
          class="w-full px-4 py-3 text-center text-lg font-bold tracking-wider bg-[var(--clr-surface-alt)] border-2 border-dashed border-[var(--clr-primary)] rounded-xl cursor-pointer select-all"
          style="color: var(--clr-primary)"
          id="discount-code-input"
        />
        <button
          type="button"
          id="copy-discount-code"
          class="absolute end-2 top-1/2 -translate-y-1/2 p-2 rounded-lg hover:bg-[var(--clr-surface)] transition-colors"
          style="color: var(--clr-text-2)"
        >
          <Icon name="heroicons:clipboard-document" class="w-5 h-5" />
        </button>
      </div>
      
      <!-- Countdown -->
      <div class="text-center">
        <p class="text-xs font-medium mb-2" style="color: var(--clr-text-2)">
          {content.urgencyExpires || "العرض ينتهي خلال"}
        </p>
        <div id="urgency-countdown" class="flex items-center justify-center gap-2">
          <div class="px-3 py-2 rounded-lg bg-[var(--clr-surface-alt)]">
            <span class="text-xl font-bold block" style="color: var(--clr-text)" id="countdown-hours">00</span>
            <span class="text-[0.625rem] font-medium" style="color: var(--clr-text-2)">ساعة</span>
          </div>
          <span class="text-lg font-bold" style="color: var(--clr-text-2)">:</span>
          <div class="px-3 py-2 rounded-lg bg-[var(--clr-surface-alt)]">
            <span class="text-xl font-bold block" style="color: var(--clr-text)" id="countdown-minutes">00</span>
            <span class="text-[0.625rem] font-medium" style="color: var(--clr-text-2)">دقيقة</span>
          </div>
          <span class="text-lg font-bold" style="color: var(--clr-text-2)">:</span>
          <div class="px-3 py-2 rounded-lg bg-[var(--clr-surface-alt)]">
            <span class="text-xl font-bold block" style="color: var(--clr-text)" id="countdown-seconds">00</span>
            <span class="text-[0.625rem] font-medium" style="color: var(--clr-text-2)">ثانية</span>
          </div>
        </div>
      </div>
      
      <!-- CTA Button -->
      <button
        type="button"
        id="apply-discount-btn"
        class="w-full py-4 rounded-xl font-bold text-base text-white transition-all duration-200 shadow-lg hover:shadow-xl active:scale-[0.98]"
        style="background: var(--clr-primary)"
      >
        <span class="flex items-center justify-center gap-2">
          <Icon name="heroicons:sparkles" class="w-5 h-5" />
          {content.urgencyCta || "طبق الخصم"}
        </span>
      </button>
      
      <!-- Close button -->
      <button
        type="button"
        id="close-urgency-popup"
        class="w-full py-2 text-sm font-medium transition-colors hover:opacity-70"
        style="color: var(--clr-text-2)"
      >
        {content.urgencyClose || "لاحقاً"}
      </button>
    </div>
  </div>
</div>

<script define:vars={{ delaySeconds, discountPercent, discountCode, expiresAt }}>
  // Store popup config globally
  window.__urgencyPopup = {
    enabled: true,
    delaySeconds,
    discountPercent,
    discountCode,
    expiresAt
  };
</script>
