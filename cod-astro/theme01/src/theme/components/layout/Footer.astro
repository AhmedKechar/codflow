---
import { Image } from "astro:assets";
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import type { SiteBuilderConfig } from "../../../../../../cod-shared/site-builder";
import { Icon } from "astro-icon/components";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
  siteBuilder?: SiteBuilderConfig;
}

const { config, content } = Astro.props;
const siteBuilder = Astro.props.siteBuilder;
const showBrand = siteBuilder?.footer.showBrand ?? true;
const showLinks = siteBuilder?.footer.showLinks ?? true;
const showSocials = siteBuilder?.footer.showSocials ?? false;
const socials = siteBuilder?.socials ?? [];
const year = new Date().getFullYear();

const badges = [
  { icon: "heroicons:credit-card", title: content?.trust1Title ?? "الدفع عند الاستلام", sub: content?.trust1Sub ?? "بدون دفع مسبق" },
  { icon: "heroicons:truck",       title: content?.trust2Title ?? "توصيل لجميع الولايات", sub: content?.trust2Sub ?? "58 ولاية" },
  { icon: "heroicons:bolt",        title: content?.trust3Title ?? "تأكيد سريع", sub: content?.trust3Sub ?? "خلال 24 ساعة" },
];
---

<footer class="mt-8 border-t border-border pb-16 sm:pb-4" style="background: var(--clr-surface-alt)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8">
      {/* Brand Column */}
      {showBrand && (
      <div class="md:col-span-4 space-y-3">
        <a href="/" class="flex items-center gap-3">
          {config.logoUrl ? (
            <Image
              src={config.logoUrl}
              alt={config.name}
              width={120}
              height={32}
              format="webp"
              quality={90}
              class="h-8 w-auto object-contain"
              loading="lazy"
            />
          ) : (
            <span class="text-xl font-semibold tracking-tight text-text-main">{config.name}</span>
          )}
        </a>
        <p class="text-sm font-normal leading-relaxed max-w-sm text-text-muted">
          {content?.footerAbout}
        </p>
        {showSocials && socials.length > 0 && (
          <SocialLinks
            socials={socials}
            itemClass="w-9 h-9"
            ariaLabel={content?.ariaSocials ?? "Social"}
          />
        )}
      </div>
      )}

      {/* Links Columns */}
      {showLinks && (
      <div class={showBrand ? "md:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-6" : "md:col-span-12 grid grid-cols-2 sm:grid-cols-3 gap-6"}>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest mb-4 text-text-main">
            {content?.footerQuickLinks}
          </h3>
          <ul class="space-y-3">
            {[
              { label: content?.navHome, href: "/" },
              { label: content?.navProducts, href: "/products" },
              { label: content?.navNewArrivals, href: "/products" },
              { label: content?.navBestSellers, href: "/products" },
            ].map((link) => (
              <li>
                <a href={link.href} class="text-sm font-normal transition-colors hover:text-primary text-text-muted">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest mb-4 text-text-main">
            {content?.footerSupport}
          </h3>
          <ul class="space-y-3">
            {[
              { label: content?.footerShipping },
              { label: content?.footerReturns },
              { label: content?.navContact },
            ].map((link) => (
              <li>
                <span class="text-sm font-normal transition-colors cursor-pointer text-text-muted hover:text-primary">
                  {link.label}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <h3 class="text-xs font-semibold uppercase tracking-widest mb-4 text-text-main">
            {content?.trust1Title}
          </h3>
          <div class="space-y-3">
            {badges.map((b) => (
              <div class="flex items-center gap-3 group">
                <div class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center bg-surface border border-border text-primary">
                  <Icon name={b.icon} class="w-4 h-4" />
                </div>
                <div class="min-w-0">
                  <p class="text-xs font-semibold leading-tight text-text-main">{b.title}</p>
                  <p class="text-[0.75rem] font-normal text-text-muted">{b.sub}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      )}
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-border mt-8 pt-5 text-center">
      <p class="text-xs font-normal text-text-muted">
        &copy; {year} {config.name}. {content?.footerRights}
      </p>
    </div>
  </div>
</footer>
