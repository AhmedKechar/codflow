---
interface Props {
  lang?: string;
}

const { lang = 'ar' } = Astro.props;

const features = {
  ar: [
    {
      icon: '📦',
      title: 'إدارة المنتجات',
      description: 'إضافة وتعديل المنتجات مع الصور والأحجام والمخزون',
    },
    {
      icon: '🛒',
      title: 'سلة مشتريات ذكية',
      description: 'سلة مشتريات متكاملة مع حساب تلقائي للرسوم',
    },
    {
      icon: '🚚',
      title: 'توصيل مرن',
      description: 'دعم الدفع عند الاستلام مع شركات توصيل متعددة',
    },
    {
      icon: '📊',
      title: 'تحليلات متقدمة',
      description: 'تقارير مبيعات تفصيلية ورسوم بيانية تفاعلية',
    },
    {
      icon: '🤖',
      title: 'مساعد AI',
      description: 'وصف المنتجات التلقائي وتحليل سلوك العملاء',
    },
    {
      icon: '👥',
      title: 'إدارة الفريق',
      description: 'أضف أعضاء الفريق مع صلاحيات مختلفة',
    },
  ],
  en: [
    {
      icon: '📦',
      title: 'Product Management',
      description: 'Add and edit products with images, variants, and inventory',
    },
    {
      icon: '🛒',
      title: 'Smart Cart',
      description: 'Integrated shopping cart with automatic fee calculation',
    },
    {
      icon: '🚚',
      title: 'Flexible Delivery',
      description: 'Cash on delivery support with multiple carriers',
    },
    {
      icon: '📊',
      title: 'Advanced Analytics',
      description: 'Detailed sales reports and interactive charts',
    },
    {
      icon: '🤖',
      title: 'AI Assistant',
      description: 'Automatic product descriptions and customer behavior analysis',
    },
    {
      icon: '👥',
      title: 'Team Management',
      description: 'Add team members with different permissions',
    },
  ],
  fr: [
    {
      icon: '📦',
      title: 'Gestion des Produits',
      description: 'Ajoutez et modifiez les produits avec images, variantes et stock',
    },
    {
      icon: '🛒',
      title: 'Panier Intelligent',
      description: 'Panier intégré avec calcul automatique des frais',
    },
    {
      icon: '🚚',
      title: 'Livraison Flexible',
      description: 'Paiement à la livraison avec transporteurs multiples',
    },
    {
      icon: '📊',
      title: 'Analyses Avancées',
      description: 'Rapports de ventes détaillés et graphiques interactifs',
    },
    {
      icon: '🤖',
      title: 'Assistant IA',
      description: 'Descriptions automatiques et analyse du comportement client',
    },
    {
      icon: '👥',
      title: 'Gestion d\'Équipe',
      description: 'Ajoutez des membres avec différentes permissions',
    },
  ],
};

const items = features[lang as keyof typeof features] ?? features.ar;
---

<section id="features" class="py-20 bg-white/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-black text-gray-900 mb-4">
        {lang === 'ar' ? 'مميزات قوية لمتجرك' : lang === 'fr' ? 'Fonctionnalités Puissantes' : 'Powerful Features'}
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        {lang === 'ar' ? 'كل ما تحتاجه لإدارة متجرك الإلكتروني بنجاح' : lang === 'fr' ? 'Tout ce dont vous avez besoin pour gérer votre boutique' : 'Everything you need to run your online store'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {items.map((feature) => (
        <div class="glass-card rounded-2xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
          <div class="text-4xl mb-4">{feature.icon}</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">{feature.title}</h3>
          <p class="text-gray-600 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
