---

<section class="relative pt-32 pb-20 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-primary-50/50 via-white to-blue-50/50"></div>
  <div class="absolute top-20 right-10 w-72 h-72 bg-primary-200/30 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-10 left-10 w-64 h-64 bg-blue-200/30 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/60 backdrop-blur-sm rounded-full border border-white/20 shadow-sm mb-8">
        <span class="text-sm font-medium text-gray-700">{content.badge}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-gray-900 leading-tight mb-6">
        {content.title}
      </h1>

      <p class="text-lg sm:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
        {content.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href="http://localhost:3000"
          class="px-8 py-4 text-base font-bold text-white bg-gradient-to-r from-primary-500 to-primary-600 rounded-2xl hover:shadow-xl hover:shadow-primary-500/25 transition-all active:scale-95"
        >
          {content.cta}
        </a>
        <a
          href="#features"
          class="px-8 py-4 text-base font-semibold text-gray-700 bg-white/60 backdrop-blur-sm rounded-2xl border border-white/20 hover:bg-white/80 transition-all"
        >
          {content.ctaSecondary}
        </a>
      </div>

      <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto">
        {content.stats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-primary-600">{stat.value}</div>
            <div class="text-sm text-gray-500 mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
